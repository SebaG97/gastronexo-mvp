NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/gastronexo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173

# Limites de intentos de autenticacion (opcionales; estos son los defaults).
# Login: por IP + email. Registro: por IP. Contadores en memoria de cada instancia.
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_REGISTER_MAX_PER_HOUR=5

# Avisos de pedidos nuevos (opcionales; ver docs/mision-7.4-avisos-telegram-email.md).
# Telegram: token del bot creado con @BotFather.
# TELEGRAM_BOT_TOKEN=
# Email con Resend: API key y remitente de un dominio verificado.
# RESEND_API_KEY=
# EMAIL_FROM=Gastronexo <pedidos@tudominio.com>
# URL publica de la consola, para el link de los avisos.
# PUBLIC_APP_URL=https://app.tudominio.com

# Detras de un proxy o balanceador: true, cantidad de saltos o lista de IPs/CIDR.
# Sin esto, los limites ven la IP del proxy y no la del cliente.
# TRUST_PROXY=1

# Pool de conexiones de la API (opcionales; estos son los defaults).
# Si todas las conexiones estan ocupadas, una request espera como mucho
# DB_POOL_CONNECTION_TIMEOUT_MS y la API responde 503 en lugar de colgarse.
DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=30000

# Protecciones de sesion en PostgreSQL, en milisegundos (opcionales; defaults).
# statement_timeout: corta una sentencia que tarda demasiado.
# lock_timeout: corta la espera por un bloqueo de fila (contencion) -> 503.
# idle_in_transaction_session_timeout: cierra una transaccion abierta e inactiva.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# /ready usa una conexion propia con este timeout, independiente del pool de la API.
DB_READY_TIMEOUT_MS=1000
