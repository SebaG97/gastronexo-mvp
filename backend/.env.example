NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/gastronexo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
FRONTEND_ORIGIN=http://localhost:5173

# Pool de conexiones de la API (opcionales; estos son los defaults).
# Si todas las conexiones estan ocupadas, una request espera como mucho
# DB_POOL_CONNECTION_TIMEOUT_MS y la API responde 503 en lugar de colgarse.
DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_MS=30000

# Protecciones de sesion en PostgreSQL, en milisegundos (opcionales; defaults).
# statement_timeout: corta una sentencia que tarda demasiado.
# lock_timeout: corta la espera por un bloqueo de fila (contencion) -> 503.
# idle_in_transaction_session_timeout: cierra una transaccion abierta e inactiva.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000

# /ready usa una conexion propia con este timeout, independiente del pool de la API.
DB_READY_TIMEOUT_MS=1000
