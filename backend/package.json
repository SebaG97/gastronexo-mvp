{
  "name": "gastronexo-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "stress:writes": "node scripts/stress-writes.mjs",
    "stress:exhaustion": "node scripts/stress-pool-exhaustion.mjs",
    "check:consistency": "node scripts/check-consistency.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
